# Copie para .env (desenvolvimento local) e cadastre as mesmas variáveis na Vercel:
# Project > Settings > Environment Variables.

# --- Públicas (front-end) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Servidor (SSR e funções de servidor): mesma URL e chave pública ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- SECRETAS: nunca commitar; só na Vercel (Environment Variables) ---
# Necessária para a cozinha/admin mudarem o status dos pedidos (src/lib/staff.functions.ts)
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: recursos de IA (resumo, imagem, pedido por voz)
LOVABLE_API_KEY=
